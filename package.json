  },
  "files": [
    "npm/bin/etherscan.js",
    "npm/postinstall.js",
    "npm/prepublish-check.js",
    "scripts/install.sh",
    "scripts/install.ps1",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
